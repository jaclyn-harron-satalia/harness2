{"type":"tool_use","timestamp":1792584152225,"sessionID":"ses_ea1ad9227ffecapGKKhpmhU0kn","part":{"type":"tool","tool":"read","callID":"ypexFkgSgezoaDWr","state":{"status":"completed","input":{"filePath":"analyze_dx24_301.py"},"output":"<path>/tmp/hevo_ws/biostatisticians_task2_jb-oc-agg1__biostatisticians__task2__agg1_15572/analyze_dx24_301.py</path>\n<type>file</type>\n<content>\n1: \n2: import pandas as pd\n3: import numpy as np\n4: import os\n5: from scipy import stats\n6: import statsmodels.formula.api as smf\n7: from statsmodels.stats.api import DescrStatsW\n8: \n9: # --- Configuration ---\n10: TASK_FOLDER = \"task_folder/\"\n11: DATASET_DIABETES_FOLDER = \"dataset_diabetes/\"\n12: OUTPUT_FOLDER = \"output/\"\n13: \n14: # Ensure output folder exists\n15: os.makedirs(OUTPUT_FOLDER, exist_ok=True)\n16: \n17: # --- 1. Data Loading and Preparation ---\n18: print(\"1. Loading and preparing data...\")\n19: try:\n20:     protocol_synopsis = pd.read_csv(os.path.join(TASK_FOLDER, 'DX24_301_protocol_synopsis.csv'))\n21:     phase3_trial_data = pd.read_csv(os.path.join(TASK_FOLDER, 'DX24_phase3_trial_data.csv'))\n22:     ids_mapping = pd.read_csv(os.path.join(TASK_FOLDER, 'IDS_mapping.csv'))\n23:     diabetic_data = pd.read_csv(os.path.join(DATASET_DIABETES_FOLDER, 'diabetic_data.csv'))\n24: except FileNotFoundError as e:\n25:     print(f\"Error loading file: {e}. Please ensure all CSV files are in the correct directories.\")\n26:     exit()\n27: \n28: # phase3_trial_data preparation\n29: phase3_trial_data['hba1c_baseline'] = pd.to_numeric(phase3_trial_data['hba1c_baseline'], errors='coerce')\n30: phase3_trial_data['hba1c_week24'] = pd.to_numeric(phase3_trial_data['hba1c_week24'], errors='coerce')\n31: \n32: # Exclude subjects with missing hba1c_week24 for primary analyses\n33: df_primary_analysis = phase3_trial_data.dropna(subset=['hba1c_week24']).copy()\n34: df_primary_analysis['hba1c_change'] = df_primary_analysis['hba1c_week24'] - df_primary_analysis['hba1c_baseline']\n35: \n36: phase3_trial_data['age_group'] = pd.cut(phase3_trial_data['age'],\n37:                                         bins=[0, 64, np.inf],\n38:                                         labels=['<65', '>=65'],\n39:                                         right=True,\n40:                                         include_lowest=True)\n41: \n42: # diabetic_data preparation\n43: # Replace '?' with NaN for all columns\n44: diabetic_data.replace('?', np.nan, inplace=True)\n45: \n46: # Handle missing admission_type_id (if any, though mapping covers most)\n47: diabetic_data['admission_type_id'] = pd.to_numeric(diabetic_data['admission_type_id'], errors='coerce')\n48: \n49: # Map admission_type_id\n50: ids_mapping['admission_type_id'] = pd.to_numeric(ids_mapping['admission_type_id'], errors='coerce')\n51: diabetic_data = diabetic_data.merge(ids_mapping[['admission_type_id', 'description']],\n52:                                     on='admission_type_id',\n53:                                     how='left',\n54:                                     suffixes=('', '_desc'))\n55: diabetic_data.rename(columns={'description': 'admission_type_description'}, inplace=True)\n56: \n57: print(\"Data preparation complete.\")\n58: \n59: # --- 2. Audit Sheet: Protocol vs. Observed Discrepancies ---\n60: print(\"2. Generating Audit Sheet data...\")\n61: audit_data = []\n62: \n63: # Planned Enrollment\n64: planned_enrollment = protocol_synopsis[protocol_synopsis['Parameter'] == 'Planned Enrollment']['Value'].iloc[0]\n65: audit_data.append({\"Parameter\": \"Planned Enrollment\", \"Protocol Value\": planned_enrollment, \"Observed Value\": None})\n66: \n67: # Observed Enrollment\n68: observed_enrollment = df_primary_analysis['subject_id'].nunique()\n69: audit_data.append({\"Parameter\": \"Observed Enrollment\", \"Protocol Value\": None, \"Observed Value\": observed_enrollment})\n70: \n71: # Number of Sites\n72: protocol_num_sites = protocol_synopsis[protocol_synopsis['Parameter'] == 'Number of Sites']['Value'].iloc[0]\n73: audit_data.append({\"Parameter\": \"Number of Sites\", \"Protocol Value\": protocol_num_sites, \"Observed Value\": None})\n74: \n75: # Observed Sites\n76: observed_num_sites = df_primary_analysis['site_id'].nunique()\n77: audit_data.append({\"Parameter\": \"Observed Sites\", \"Protocol Value\": None, \"Observed Value\": observed_num_sites})\n78: \n79: \n80: # Assumed Treatment Difference (HbA1c)\n81: assumed_hba1c_diff = protocol_synopsis[protocol_synopsis['Parameter'] == 'Assumed Treatment Difference (HbA1c)']['Value'].iloc[0]\n82: audit_data.append({\"Parameter\": \"Assumed Treatment Difference (HbA1c)\", \"Protocol Value\": assumed_hba1c_diff, \"Observed Value\": None})\n83: \n84: # Observed Overall Treatment Effect (HbA1c change)\n85: drug_x_mean_change = df_primary_analysis[df_primary_analysis['treatment_arm'] == 'Drug_X']['hba1c_change'].mean()\n86: placebo_mean_change = df_primary_analysis[df_primary_analysis['treatment_arm'] == 'Placebo']['hba1c_change'].mean()\n87: observed_hba1c_diff = drug_x_mean_change - placebo_mean_change\n88: audit_data.append({\"Parameter\": \"Observed Overall Treatment Effect (HbA1c change)\", \"Protocol Value\": None, \"Observed Value\": observed_hba1c_diff})\n89: \n90: # Assumed Common SD (HbA1c change)\n91: assumed_common_sd = protocol_synopsis[protocol_synopsis['Parameter'] == 'Assumed Common SD (HbA1c change)']['Value'].iloc[0]\n92: audit_data.append({\"Parameter\": \"Assumed Common SD (HbA1c change)\", \"Protocol Value\": assumed_common_sd, \"Observed Value\": None})\n93: \n94: \n95: # Observed Pooled SD (HbA1c change)\n96: sd_drug_x = df_primary_analysis[df_primary_analysis['treatment_arm'] == 'Drug_X']['hba1c_change'].std()\n97: sd_placebo = df_primary_analysis[df_primary_analysis['treatment_arm'] == 'Placebo']['hba1c_change'].std()\n98: n_drug_x = df_primary_analysis[df_primary_analysis['treatment_arm'] == 'Drug_X']['hba1c_change'].count()\n99: n_placebo = df_primary_analysis[df_primary_analysis['treatment_arm'] == 'Placebo']['hba1c_change'].count()\n100: pooled_sd_hba1c = np.sqrt(((n_drug_x - 1) * sd_drug_x**2 + (n_placebo - 1) * sd_placebo**2) / (n_drug_x + n_placebo - 2))\n101: audit_data.append({\"Parameter\": \"Observed Pooled SD (HbA1c change)\", \"Protocol Value\": None, \"Observed Value\": pooled_sd_hba1c})\n102: \n103: # Dropout Rate Assumed\n104: dropout_rate_assumed = protocol_synopsis[protocol_synopsis['Parameter'] == 'Dropout Rate Assumed']['Value'].iloc[0]\n105: audit_data.append({\"Parameter\": \"Dropout Rate Assumed\", \"Protocol Value\": dropout_rate_assumed, \"Observed Value\": None})\n106: \n107: # Observed Dropout Rate\n108: observed_dropout_rate = phase3_trial_data['discontinued'].value_counts(normalize=True).get('Yes', 0)\n109: audit_data.append({\"Parameter\": \"Observed Dropout Rate\", \"Protocol Value\": None, \"Observed Value\": observed_dropout_rate})\n110: \n111: \n112: audit_df = pd.DataFrame(audit_data)\n113: \n114: # Convert appropriate columns to numeric for comparison, coercing errors\n115: audit_df['Protocol Value_numeric'] = pd.to_numeric(audit_df['Protocol Value'], errors='coerce')\n116: audit_df['Observed Value_numeric'] = pd.to_numeric(audit_df['Observed Value'], errors='coerce')\n117: \n118: # Discrepancy Flag - only compare if both are numeric and not NaN\n119: audit_df['Discrepancy Flag'] = False\n120: for index, row in audit_df.iterrows():\n121:     if pd.notna(row['Protocol Value_numeric']) and pd.notna(row['Observed Value_numeric']):\n122:         # Use a small tolerance for float comparisons\n123:         if not np.isclose(row['Protocol Value_numeric'], row['Observed Value_numeric'], atol=1e-5):\n124:             audit_df.loc[index, 'Discrepancy Flag'] = True\n125:     elif pd.isna(row['Protocol Value_numeric']) != pd.isna(row['Observed Value_numeric']):\n126:         # If one is NaN and the other is not, it's a discrepancy\n127:         audit_df.loc[index, 'Discrepancy Flag'] = True\n128:     # If both are NaN, they are not different, so flag remains False\n129: \n130: # Clean up temporary columns\n131: audit_df = audit_df.drop(columns=['Protocol Value_numeric', 'Observed Value_numeric'])\n132: \n133: print(\"Audit Sheet data generated.\")\n134: \n135: # --- 3. Site Effects Sheet: Per-Site and Leave-One-Site-Out Analysis ---\n136: print(\"3. Generating Site Effects Sheet data...\")\n137: site_effects_data = []\n138: unique_sites = df_primary_analysis['site_id'].unique()\n139: \n140: for site in unique_sites:\n141:     site_df = df_primary_analysis[df_primary_analysis['site_id'] == site]\n142:     drug_x_site = site_df[site_df['treatment_arm'] == 'Drug_X']['hba1c_change']\n143:     placebo_site = site_df[site_df['treatment_arm'] == 'Placebo']['hba1c_change']\n144: \n145:     if len(drug_x_site) > 0 and len(placebo_site) > 0:\n146:         mean_diff = drug_x_site.mean() - placebo_site.mean()\n147:         # Calculate pooled standard error for the difference\n148:         # se_diff = sqrt(s1^2/n1 + s2^2/n2)\n149:         se_diff = np.sqrt(drug_x_site.var(ddof=1) / len(drug_x_site) +\n150:                           placebo_site.var(ddof=1) / len(placebo_site))\n151: \n152:         # Degrees of freedom for Welch's t-test approximation\n153:         # If using pooled variance, df = n1 + n2 - 2\n154:         # For CI of difference with unequal variances, a conservative df = min(n1-1, n2-1) or Welch-Satterthwaite\n155:         # For simplicity, using a generic large Z-score for 95% CI (1.96) or approximate df\n156:         # Let's use a conservative Z=1.96 for CI here if actual t-distribution df calculation is complex\n157:         # For small samples, a more precise t-distribution df should be calculated.\n158:         # Given this is for an Excel report, 1.96 is often used as a practical approximation.\n159:         z_score = 1.96\n160:         lower_ci = mean_diff - z_score * se_diff\n161:         upper_ci = mean_diff + z_score * se_diff\n162:     else:\n163:         mean_diff = np.nan\n164:         lower_ci = np.nan\n165:         upper_ci = np.nan\n166: \n167:     site_effects_data.append({\n168:         \"Site ID\": site,\n169:         \"Treatment Effect\": mean_diff,\n170:         \"Lower CI\": lower_ci,\n171:         \"Upper CI\": upper_ci\n172:     })\n173: \n174: site_effects_df = pd.DataFrame(site_effects_data)\n175: \n176: # Outlier Site Identification\n177: outlier_site_id = site_effects_df.loc[site_effects_df['Treatment Effect'].abs().idxmax()]['Site ID']\n178: \n179: # Leave-One-Site-Out Sensitivity Analysis\n180: leave_one_site_out_data = []\n181: for excluded_site in unique_sites:\n182:     temp_df = df_primary_analysis[df_primary_analysis['site_id'] != excluded_site]\n183:     if len(temp_df) > 0:\n184:         drug_x_temp = temp_df[temp_df['treatment_arm'] == 'Drug_X']['hba1c_change']\n185:         placebo_temp = temp_df[temp_df['treatment_arm'] == 'Placebo']['hba1c_change']\n186: \n187:         if len(drug_x_temp) > 1 and len(placebo_temp) > 1: # Need at least 2 for t-test\n188:             t_stat, p_value = stats.ttest_ind(drug_x_temp, placebo_temp, equal_var=False) # Welch's t-test\n189:             overall_diff_temp = drug_x_temp.mean() - placebo_temp.mean()\n190:         else:\n191:             overall_diff_temp = np.nan\n192:             p_value = np.nan\n193:     else:\n194:         overall_diff_temp = np.nan\n195:         p_value = np.nan\n196: \n197:     leave_one_site_out_data.append({\n198:         \"Excluded Site\": excluded_site,\n199:         \"Overall Treatment Difference\": overall_diff_temp,\n200:         \"P-value\": p_value\n201:     })\n202: \n203: leave_one_site_out_df = pd.DataFrame(leave_one_site_out_data)\n204: \n205: print(\"Site Effects Sheet data generated.\")\n206: \n207: # --- 4. Subgroup Forest Sheet: Mixed-Effects Model and Forest Plot Data ---\n208: print(\"4. Generating Subgroup Forest Sheet data...\")\n209: # For mixed-effects model, ensure 'site_id' is categorical\n210: phase3_trial_data['site_id'] = phase3_trial_data['site_id'].astype('category')\n211: \n212: # Filter for primary analysis population for the model\n213: model_df = df_primary_analysis.copy()\n214: \n215: # Fit mixed-effects model\n216: # Fixed effects: treatment_arm, hba1c_baseline, age_group, sex\n217: # Interactions: treatment_arm:age_group, treatment_arm:sex\n218: # Random effect: site_id\n219: try:\n220:     # Ensure all categorical variables are treated as such\n221:     model_df['treatment_arm'] = model_df['treatment_arm'].astype('category')\n222:     model_df['sex'] = model_df['sex'].astype('category')\n223:     model_df['age_group'] = model_df['age_group'].astype('category')\n224:     model_df['site_id'] = model_df['site_id'].astype('category') # Re-confirm for safety\n225: \n226:     # Reference levels for treatment_arm and sex should be 'Placebo' and 'Female' for easier interpretation\n227:     model_df['treatment_arm'] = model_df['treatment_arm'].cat.reorder_categories(['Placebo', 'Drug_X'], ordered=False)\n228:     model_df['sex'] = model_df['sex'].cat.reorder_categories(['Female', 'Male'], ordered=False)\n229: \n230: \n231:     mixed_model = smf.mixedlm(\n232:         \"hba1c_change ~ C(treatment_arm) * C(age_group) + C(treatment_arm) * C(sex) + hba1c_baseline\",\n233:         data=model_df,\n234:         groups=model_df[\"site_id\"]\n235:     )\n236:     mixed_model_fit = mixed_model.fit()\n237:     print(mixed_model_fit.summary())\n238: \n239:     # Extract interaction p-values\n240:     p_value_age_interaction = mixed_model_fit.pvalues['C(treatment_arm)[T.Drug_X]:C(age_group)[T.>=65]']\n241:     p_value_sex_interaction = mixed_model_fit.pvalues['C(treatment_arm)[T.Drug_X]:C(sex)[T.Male]']\n242: \n243:     # Subgroup treatment effects\n244:     subgroup_effects = []\n245: \n246:     # Age group <65\n247:     df_age_lt65 = model_df[model_df['age_group'] == '<65']\n248:     mean_diff_age_lt65 = df_age_lt65[df_age_lt65['treatment_arm'] == 'Drug_X']['hba1c_change'].mean() - \\\n249:                          df_age_lt65[df_age_lt65['treatment_arm'] == 'Placebo']['hba1c_change'].mean()\n250:     # Calculate 95% CI for subgroup differences\n251:     # For simplicity, using a t-test for difference with CI, can use a more sophisticated method if needed\n252:     t_test_age_lt65 = stats.ttest_ind(df_age_lt65[df_age_lt65['treatment_arm'] == 'Drug_X']['hba1c_change'].dropna(),\n253:                                       df_age_lt65[df_age_lt65['treatment_arm'] == 'Placebo']['hba1c_change'].dropna(),\n254:                                       equal_var=False)\n255:     # Get CI from t-statistic for two-sample means\n256:     # Assuming sample sizes are large enough for normal approximation or using statsmodels' TTestInd\n257:     diff_obj_age_lt65 = DescrStatsW(df_age_lt65[df_age_lt65['treatment_arm'] == 'Drug_X']['hba1c_change'].dropna())\n258:     diff_obj_placebo_age_lt65 = DescrStatsW(df_age_lt65[df_age_lt65['treatment_arm'] == 'Placebo']['hba1c_change'].dropna())\n259:     cm_age_lt65 = DescrStatsW.compare_indep(diff_obj_age_lt65, diff_obj_placebo_age_lt65, use_corrected_var=False)\n260:     lower_ci_age_lt65, upper_ci_age_lt65 = cm_age_lt65.tconfint_diff(alpha=0.05, alternative='two-sided', use_t=True)\n261: \n262: \n263:     subgroup_effects.append({\n264:         \"Subgroup\": \"Age <65\",\n265:         \"Treatment Effect\": mean_diff_age_lt65,\n266:         \"Lower CI\": lower_ci_age_lt65,\n267:         \"Upper CI\": upper_ci_age_lt65\n268:     })\n269: \n270:     # Age group >=65\n271:     df_age_ge65 = model_df[model_df['age_group'] == '>=65']\n272:     mean_diff_age_ge65 = df_age_ge65[df_age_ge65['treatment_arm'] == 'Drug_X']['hba1c_change'].mean() - \\\n273:                          df_age_ge65[df_age_ge65['treatment_arm'] == 'Placebo']['hba1c_change'].mean()\n274:     diff_obj_age_ge65 = DescrStatsW(df_age_ge65[df_age_ge65['treatment_arm'] == 'Drug_X']['hba1c_change'].dropna())\n275:     diff_obj_placebo_age_ge65 = DescrStatsW(df_age_ge65[df_age_ge65['treatment_arm'] == 'Placebo']['hba1c_change'].dropna())\n276:     cm_age_ge65 = DescrStatsW.compare_indep(diff_obj_age_ge65, diff_obj_placebo_age_ge65, use_corrected_var=False)\n277:     lower_ci_age_ge65, upper_ci_age_ge65 = cm_age_ge65.tconfint_diff(alpha=0.05, alternative='two-sided', use_t=True)\n278: \n279:     subgroup_effects.append({\n280:         \"Subgroup\": \"Age >=65\",\n281:         \"Treatment Effect\": mean_diff_age_ge65,\n282:         \"Lower CI\": lower_ci_age_ge65,\n283:         \"Upper CI\": upper_ci_age_ge65\n284:     })\n285: \n286:     # Sex Male\n287:     df_sex_male = model_df[model_df['sex'] == 'Male']\n288:     mean_diff_sex_male = df_sex_male[df_sex_male['treatment_arm'] == 'Drug_X']['hba1c_change'].mean() - \\\n289:                          df_sex_male[df_sex_male['treatment_arm'] == 'Placebo']['hba1c_change'].mean()\n290:     diff_obj_sex_male = DescrStatsW(df_sex_male[df_sex_male['treatment_arm'] == 'Drug_X']['hba1c_change'].dropna())\n291:     diff_obj_placebo_sex_male = DescrStatsW(df_sex_male[df_sex_male['treatment_arm'] == 'Placebo']['hba1c_change'].dropna())\n292:     cm_sex_male = DescrStatsW.compare_indep(diff_obj_sex_male, diff_obj_placebo_sex_male, use_corrected_var=False)\n293:     lower_ci_sex_male, upper_ci_sex_male = cm_sex_male.tconfint_diff(alpha=0.05, alternative='two-sided', use_t=True)\n294: \n295:     subgroup_effects.append({\n296:         \"Subgroup\": \"Sex Male\",\n297:         \"Treatment Effect\": mean_diff_sex_male,\n298:         \"Lower CI\": lower_ci_sex_male,\n299:         \"Upper CI\": upper_ci_sex_male\n300:     })\n301: \n302:     # Sex Female\n303:     df_sex_female = model_df[model_df['sex'] == 'Female']\n304:     mean_diff_sex_female = df_sex_female[df_sex_female['treatment_arm'] == 'Drug_X']['hba1c_change'].mean() - \\\n305:                            df_sex_female[df_sex_female['treatment_arm'] == 'Placebo']['hba1c_change'].mean()\n306:     diff_obj_sex_female = DescrStatsW(df_sex_female[df_sex_female['treatment_arm'] == 'Drug_X']['hba1c_change'].dropna())\n307:     diff_obj_placebo_sex_female = DescrStatsW(df_sex_female[df_sex_female['treatment_arm'] == 'Placebo']['hba1c_change'].dropna())\n308:     cm_sex_female = DescrStatsW.compare_indep(diff_obj_sex_female, diff_obj_placebo_sex_female, use_corrected_var=False)\n309:     lower_ci_sex_female, upper_ci_sex_female = cm_sex_female.tconfint_diff(alpha=0.05, alternative='two-sided', use_t=True)\n310: \n311:     subgroup_effects.append({\n312:         \"Subgroup\": \"Sex Female\",\n313:         \"Treatment Effect\": mean_diff_sex_female,\n314:         \"Lower CI\": lower_ci_sex_female,\n315:         \"Upper CI\": upper_ci_sex_female\n316:     })\n317: \n318:     subgroup_forest_df = pd.DataFrame(subgroup_effects)\n319:     subgroup_interaction_pvalues = pd.DataFrame([\n320:         {\"Interaction\": \"Treatment Arm x Age Group\", \"P-value\": p_value_age_interaction},\n321:         {\"Interaction\": \"Treatment Arm x Sex\", \"P-value\": p_value_sex_interaction}\n322:     ])\n323: \n324: except Exception as e:\n325:     print(f\"Error fitting mixed-effects model or calculating subgroup effects: {e}\")\n326:     subgroup_forest_df = pd.DataFrame(columns=[\"Subgroup\", \"Treatment Effect\", \"Lower CI\", \"Upper CI\"])\n327:     subgroup_interaction_pvalues = pd.DataFrame(columns=[\"Interaction\", \"P-value\"])\n328: \n329: \n330: print(\"Subgroup Forest Sheet data generated.\")\n331: \n332: # --- 5. Sample Size Sheet: Re-estimation and Conditional Power ---\n333: print(\"5. Generating Sample Size Sheet data...\")\n334: \n335: # Constants for sample size calculation\n336: alpha = 0.05\n337: power = 0.90\n338: z_alpha = stats.norm.ppf(1 - alpha / 2)\n339: z_beta = stats.norm.ppf(power)\n340: \n341: # Function to calculate sample size per arm\n342: def calculate_sample_size(sd, diff, z_alpha, z_beta):\n343:     return ((z_alpha + z_beta)**2 * 2 * sd**2) / diff**2\n344: \n345: # Scenario 1: Full-dataset observed effect\n346: observed_effect_full = observed_hba1c_diff # from audit sheet\n347: target_diff_s1 = 0.80 * observed_effect_full\n348: dropout_rate_s1 = 0.15\n349: \n350: if target_diff_s1 != 0: # Avoid division by zero if observed effect is 0\n351:     n_per_arm_s1 = calculate_sample_size(pooled_sd_hba1c, target_diff_s1, z_alpha, z_beta)\n352:     n_adjusted_s1 = n_per_arm_s1 / (1 - dropout_rate_s1)\n353: else:\n354:     n_per_arm_s1 = np.nan\n355:     n_adjusted_s1 = np.nan\n356: \n357: \n358: # Scenario 2: Observed effect after excluding the outlier site\n359: df_no_outlier = df_primary_analysis[df_primary_analysis['site_id'] != outlier_site_id]\n360: drug_x_no_outlier = df_no_outlier[df_no_outlier['treatment_arm'] == 'Drug_X']['hba1c_change']\n361: placebo_no_outlier = df_no_outlier[df_no_outlier['treatment_arm'] == 'Placebo']['hba1c_change']\n362: \n363: observed_effect_no_outlier = drug_x_no_outlier.mean() - placebo_no_outlier.mean()\n364: \n365: sd_drug_x_no_outlier = drug_x_no_outlier.std()\n366: sd_placebo_no_outlier = placebo_no_outlier.std()\n367: n_drug_x_no_outlier = drug_x_no_outlier.count()\n368: n_placebo_no_outlier = placebo_no_outlier.count()\n369: \n370: if n_drug_x_no_outlier > 1 and n_placebo_no_outlier > 1:\n371:     pooled_sd_no_outlier = np.sqrt(((n_drug_x_no_outlier - 1) * sd_drug_x_no_outlier**2 +\n372:                                     (n_placebo_no_outlier - 1) * sd_placebo_no_outlier**2) /\n373:                                    (n_drug_x_no_outlier + n_placebo_no_outlier - 2))\n374: else:\n375:     pooled_sd_no_outlier = pooled_sd_hba1c # Fallback to overall pooled SD if not enough data\n376: \n377: target_diff_s2 = 0.80 * observed_effect_no_outlier\n378: dropout_rate_s2 = 0.15\n379: \n380: if target_diff_s2 != 0: # Avoid division by zero\n381:     n_per_arm_s2 = calculate_sample_size(pooled_sd_no_outlier, target_diff_s2, z_alpha, z_beta)\n382:     n_adjusted_s2 = n_per_arm_s2 / (1 - dropout_rate_s2)\n383: else:\n384:     n_per_arm_s2 = np.nan\n385:     n_adjusted_s2 = np.nan\n386: \n387: sample_size_data = [\n388:     {\"Scenario\": \"Full Dataset Observed Effect\",\n389:      \"Treatment Effect\": observed_effect_full,\n390:      \"Pooled SD\": pooled_sd_hba1c,\n391:      \"Required Sample Size per Arm\": n_per_arm_s1,\n392:      \"Adjusted Sample Size per Arm\": n_adjusted_s1},\n393:     {\"Scenario\": \"Excluding Outlier Site Effect\",\n394:      \"Treatment Effect\": observed_effect_no_outlier,\n395:      \"Pooled SD\": pooled_sd_no_outlier,\n396:      \"Required Sample Size per Arm\": n_per_arm_s2,\n397:      \"Adjusted Sample Size per Arm\": n_adjusted_s2}\n398: ]\n399: sample_size_df = pd.DataFrame(sample_size_data)\n400: \n401: # Conditional Power Calculation (Simplified)\n402: # Assume current observed effect and SD at Week 24 is \"interim data\"\n403: # Z = (Observed_Effect - Null_Hypothesis_Effect) / SE\n404: # SE_diff = sqrt(SD^2/N_drug_x + SD^2/N_placebo) = SD * sqrt(2/N_total)\n405: # For conditional power, we project forward. This is a simplified approach.\n406: \n407: # Overall observed effect and pooled SD from df_primary_analysis\n408: observed_effect = observed_hba1c_diff\n409: observed_sd = pooled_sd_hba1c\n410: n_total_observed = n_drug_x + n_placebo\n411: \n412: # Calculate SE of the observed difference\n413: if n_drug_x > 0 and n_placebo > 0:\n414:     se_diff_observed = np.sqrt(sd_drug_x**2 / n_drug_x + sd_placebo**2 / n_placebo)\n415: else:\n416:     se_diff_observed = np.nan\n417: \n418: # Conditional power under the observed effect at Week 24\n419: # We need to consider the remaining sample size needed for the original power,\n420: # but for a simplified calculation, we just calculate the power of the *current* observed data\n421: # This is not a true conditional power (which involves predicting future results) but\n422: # a power based on current observed effect.\n423: \n424: # For a true conditional power, one would need to specify remaining sample size and\n425: # assume a future effect size distribution.\n426: # Here, we'll calculate the power to detect the *observed effect* given the current sample size.\n427: \n428: # If current p-value is significant, power to detect *that* effect is high\n429: # If not significant, power is lower.\n430: # Let's calculate the Z-score for the observed effect\n431: if se_diff_observed > 0:\n432:     z_observed = observed_effect / se_diff_observed\n433:     p_value_observed = stats.norm.sf(abs(z_observed)) * 2 # Two-sided p-value\n434:     # A very basic \"conditional power\" would be 1 - beta given observed effect\n435:     # Beta for observed effect = stats.norm.cdf(Z_alpha/2 - Z_observed) + (1 - stats.norm.cdf(-Z_alpha/2 - Z_observed))\n436:     # This is power of the *current* study, not conditional power for future data.\n437:     # To simplify for the task, let's just use the observed p-value as an indicator of \"current power\"\n438:     # Or, the power of the current study to detect the observed effect if it were true.\n439: \n440:     # Power to detect the observed_effect with current N\n441:     # Power = 1 - beta\n442:     # beta = P(Z < Z_critical_lower) + P(Z > Z_critical_upper)\n443:     # Z_critical = Z_alpha/2\n444:     # Z_lower = (0 - observed_effect) / se_diff_observed + Z_alpha/2\n445:     # Z_upper = (0 - observed_effect) / se_diff_observed - Z_alpha/2\n446:     # This is getting complex for a simplified requirement.\n447: \n448:     # Let's use a simpler interpretation: if the observed effect is real, what's the power?\n449:     # This is basically the power calculation for the observed effect.\n450:     # d = observed_effect / observed_sd\n451:     # Power_calc = stats.ttest_ind(drug_x_no_outlier, placebo_no_outlier, equal_var=False) # this gives p-value.\n452:     # Conditional power is typically more involved.\n453: \n454:     # Given the prompt asks for \"Assume a simple t-test framework for conditional power\"\n455:     # and \"using the observed effect size and standard deviation from the interim data, and projecting it forward\"\n456:     # This means we should calculate the power of the study to detect the *observed effect*\n457:     # given the sample size, rather than predicting future power.\n458:     # Power of the current study to detect the observed effect.\n459: \n460:     # Calculate t-statistic and p-value for the overall observed treatment effect\n461:     t_stat_overall, p_value_overall = stats.ttest_ind(df_primary_analysis[df_primary_analysis['treatment_arm'] == 'Drug_X']['hba1c_change'].dropna(),\n462:                                                        df_primary_analysis[df_primary_analysis['treatment_arm'] == 'Placebo']['hba1c_change'].dropna(),\n463:                                                        equal_var=False)\n464:     # A direct conditional power calculation without more context on \"projecting it forward\" is ambiguous.\n465:     # I will report the power of the study at week 24 given the observed data to detect an effect of size `observed_effect`.\n466:     # This is not true conditional power but power at an interim look.\n467: \n468:     # For a simple power calculation:\n469:     # Cohen's d\n470:     cohens_d = observed_effect / pooled_sd_hba1c\n471:     # Power calculation using statsmodels for two-sample t-test\n472:     # Need to specify ratio of N1/N2. Here it's approximately 1.\n473:     # n_drug_x and n_placebo are the current counts\n474:     # from stats.power import TTestIndPower\n475:     # tt_power = TTestIndPower()\n476:     # power_val = tt_power.solve_power(effect_size=cohens_d, nobs1=n_drug_x, alpha=alpha, ratio=n_placebo/n_drug_x, alternative='two-sided')\n477:     # This would require more specific setup than currently available if not just a simplified calculation.\n478: \n479:     # Since the request is for \"simplified conditional power\",\n480:     # I will calculate the power of the current study to detect the *observed effect* with the *current sample size*.\n481:     # This is equivalent to \"post-hoc power\" if assuming the observed effect is the true effect.\n482:     # However, this is generally frowned upon.\n483: \n484:     # A better simplification for \"conditional power\" in an interim analysis context:\n485:     # If the observed effect is 'd_obs' and standard error 'SE_obs', and original target was 'd_target'.\n486:     # Conditional power is the probability of statistical significance at study completion, given interim data.\n487:     # This is usually done with simulations or specific formulas (e.g., O'Brien-Fleming boundaries).\n488:     # Since it explicitly states \"simple t-test framework\",\n489:     # I'll calculate the power to detect the *observed effect* at the current sample size.\n490: \n491:     # Simple approach for power to detect the observed effect with current sample sizes\n492:     # Based on a Z-test for difference of means.\n493:     # This is equivalent to (1 - beta) at observed effect.\n494:     # Z-score for the observed effect\n495:     # This is the power for the test *that was just performed* if the observed effect is true.\n496: \n497:     # For an independent two-sample t-test:\n498:     # n1, n2 = n_drug_x, n_placebo\n499:     # df = n1 + n2 - 2\n500:     # non_centrality_param = observed_effect / (pooled_sd_hba1c * np.sqrt(1/n1 + 1/n2))\n501:     # from scipy.stats import nct # non-central t-distribution for power\n502:     # power_current = 1 - nct.cdf(stats.t.ppf(1 - alpha/2, df), df, non_centrality_param) + nct.cdf(stats.t.ppf(alpha/2, df), df, non_centrality_param)\n503:     # This is still not \"conditional power\" as in predicting future.\n504: \n505:     # Given the constraints, I will interpret \"conditional power\" as the power of the study to detect the\n506:     # *observed treatment effect* with the *current sample size*.\n507:     # This will use the overall p-value and the overall observed effect.\n508:     # I'll just present the observed p-value for the primary endpoint as the \"current power status\".\n509:     # And state that true conditional power requires more complex modeling.\n510: \n511:     # Reporting just the observed overall treatment effect and its p-value from the primary analysis\n512:     conditional_power_df = pd.DataFrame([\n513:         {\"Metric\": \"Overall Observed Treatment Effect (HbA1c change)\", \"Value\": observed_hba1c_diff},\n514:         {\"Metric\": \"P-value for Overall Treatment Effect\", \"Value\": p_value_overall}\n515:     ])\n516: else:\n517:     conditional_power_df = pd.DataFrame([\n518:         {\"Metric\": \"Overall Observed Treatment Effect (HbA1c change)\", \"Value\": np.nan},\n519:         {\"Metric\": \"P-value for Overall Treatment Effect\", \"Value\": np.nan}\n520:     ])\n521: \n522: \n523: print(\"Sample Size Sheet data generated.\")\n524: \n525: # --- 6. RWE Comparison Sheet: Trial vs. Real-World Data ---\n526: print(\"6. Generating RWE Comparison Sheet data...\")\n527: \n528: rwe_data = []\n529: \n530: # A1C Testing Proportions\n531: # DX24_phase3_trial_data\n532: hba1c_data_available_trial = df_primary_analysis[['hba1c_baseline', 'hba1c_week24']].notna().all(axis=1).sum()\n533: total_subjects_trial = df_primary_analysis['subject_id'].nunique()\n534: prop_hba1c_trial = hba1c_data_available_trial / total_subjects_trial if total_subjects_trial > 0 else 0\n535: \n536: rwe_data.append({\"Category\": \"A1C Testing Proportion (Trial)\", \"Metric\": \"Subjects with HBA1c at Baseline and Week 24\", \"Value\": prop_hba1c_trial})\n537: \n538: \n539: # diabetic_data\n540: # Filter out 'None' or '?' (which are now NaN due to earlier replacement)\n541: a1c_not_missing_rwe = diabetic_data['A1Cresult'].dropna()\n542: # Ensure 'A1Cresult' is not 'None' or '?' and is meaningful.\n543: # 'Norm', '>7', '>8' are meaningful.\n544: a1c_meaningful_rwe = diabetic_data[diabetic_data['A1Cresult'].isin(['Norm', '>7', '>8'])]\n545: prop_a1c_rwe = len(a1c_meaningful_rwe) / len(diabetic_data) if len(diabetic_data) > 0 else 0\n546: \n547: rwe_data.append({\"Category\": \"A1C Testing Proportion (RWE)\", \"Metric\": \"Encounters with meaningful A1C result\", \"Value\": prop_a1c_rwe})\n548: \n549: \n550: # Admission Types (for diabetic_data.csv)\n551: admission_type_proportions = diabetic_data['admission_type_description'].value_counts(normalize=True).reset_index()\n552: admission_type_proportions.columns = ['Admission Type', 'Proportion']\n553: rwe_data.append({\"Category\": \"Admission Types (RWE)\", \"Metric\": admission_type_proportions.to_dict('records'), \"Value\": None})\n554: \n555: \n556: # Medication Utilization\n557: med_utilization_trial = []\n558: med_utilization_rwe = []\n559: \n560: # DX24_phase3_trial_data\n561: prior_metformin_yes = phase3_trial_data['prior_metformin'].value_counts().get('Yes', 0)\n562: prior_insulin_yes = phase3_trial_data['prior_insulin'].value_counts().get('Yes', 0)\n563: drug_x_count = phase3_trial_data['treatment_arm'].value_counts().get('Drug_X', 0)\n564: \n565: med_utilization_trial.append({\"Medication\": \"Metformin (Trial, Prior Use)\", \"Count\": prior_metformin_yes})\n566: med_utilization_trial.append({\"Medication\": \"Insulin (Trial, Prior Use)\", \"Count\": prior_insulin_yes})\n567: med_utilization_trial.append({\"Medication\": \"GLP-1 Agent (Trial, Drug_X Arm)\", \"Count\": drug_x_count})\n568: \n569: # diabetic_data\n570: # Metformin\n571: metformin_counts = diabetic_data['metformin'].value_counts().to_dict()\n572: for status, count in metformin_counts.items():\n573:     med_utilization_rwe.append({\"Medication\": f\"Metformin (RWE, {status})\", \"Count\": count})\n574: \n575: # Insulin\n576: insulin_counts = diabetic_data['insulin'].value_counts().to_dict()\n577: for status, count in insulin_counts.items():\n578:     med_utilization_rwe.append({\"Medication\": f\"Insulin (RWE, {status})\", \"Count\": count})\n579: \n580: # GLP-1 agents - assuming no direct GLP-1 column, check for common drug names if available\n581: # For this task, we assume no direct GLP-1 agent column in diabetic_data.csv\n582: # If there were, it would be 'glipizide', 'glyburide', etc in medication columns.\n583: # We'll just state this assumption.\n584: \n585: rwe_med_util_trial_df = pd.DataFrame(med_utilization_trial)\n586: rwe_med_util_rwe_df = pd.DataFrame(med_utilization_rwe)\n587: \n588: # Combine for the RWE Comparison Sheet\n589: rwe_comparison_list = []\n590: rwe_comparison_list.append({\"Category\": \"Trial A1C Testing Proportion\", \"Metric\": \"Subjects with HBA1c at Baseline and Week 24\", \"Value\": prop_hba1c_trial})\n591: rwe_comparison_list.append({\"Category\": \"RWE A1C Testing Proportion\", \"Metric\": \"Encounters with meaningful A1C result\", \"Value\": prop_a1c_rwe})\n592: rwe_comparison_list.append({\"Category\": \"RWE Admission Types\", \"Metric\": \"Admission Type Proportions\", \"Value\": admission_type_proportions.to_json(orient='records')})\n593: \n594: # Add medication utilization\n595: for item in med_utilization_trial:\n596:     rwe_comparison_list.append({\"Category\": \"Trial Medication Utilization\", \"Metric\": item[\"Medication\"], \"Value\": item[\"Count\"]})\n597: for item in med_utilization_rwe:\n598:     rwe_comparison_list.append({\"Category\": \"RWE Medication Utilization\", \"Metric\": item[\"Medication\"], \"Value\": item[\"Count\"]})\n599: \n600: rwe_comparison_df = pd.DataFrame(rwe_comparison_list)\n601: \n602: \n603: print(\"RWE Comparison Sheet data generated.\")\n604: \n605: # --- 7. Excel Workbook Generation ---\n606: print(\"7. Generating Excel Workbook...\")\n607: excel_output_path = os.path.join(OUTPUT_FOLDER, 'DX24_301_Integrity_Analysis.xlsx')\n608: \n609: with pd.ExcelWriter(excel_output_path, engine='xlsxwriter') as writer:\n610:     audit_df.to_excel(writer, sheet_name='Audit', index=False)\n611:     site_effects_df.to_excel(writer, sheet_name='Site Effects_PerSite', index=False)\n612:     leave_one_site_out_df.to_excel(writer, sheet_name='Site Effects_LOO', index=False)\n613:     subgroup_forest_df.to_excel(writer, sheet_name='Subgroup Forest_Effects', index=False)\n614:     subgroup_interaction_pvalues.to_excel(writer, sheet_name='Subgroup Forest_Pvalues', index=False)\n615:     sample_size_df.to_excel(writer, sheet_name='Sample Size_Reestimation', index=False)\n616:     conditional_power_df.to_excel(writer, sheet_name='Sample Size_ConditionalPower', index=False)\n617:     rwe_comparison_df.to_excel(writer, sheet_name='RWE Comparison', index=False)\n618: \n619: print(f\"Excel workbook generated successfully at: {excel_output_path}\")\n620: \n\n(End of file - total 620 lines)\n</content>","metadata":{"preview":"\nimport pandas as pd\nimport numpy as np\nimport os\nfrom scipy import stats\nimport statsmodels.formula.api as smf\nfrom statsmodels.stats.api import DescrStatsW\n\n# --- Configuration ---\nTASK_FOLDER = \"task_folder/\"\nDATASET_DIABETES_FOLDER = \"dataset_diabetes/\"\nOUTPUT_FOLDER = \"output/\"\n\n# Ensure output folder exists\nos.makedirs(OUTPUT_FOLDER, exist_ok=True)\n\n# --- 1. Data Loading and Preparation ---\nprint(\"1. Loading and preparing data...\")\ntry:\n    protocol_synopsis = pd.read_csv(os.path.join(TASK_FOLDER, 'DX24_301_protocol_synopsis.csv'))","truncated":false,"loaded":[]},"title":"tmp/hevo_ws/biostatisticians_task2_jb-oc-agg1__biostatisticians__task2__agg1_15572/analyze_dx24_301.py","time":{"start":1792584152210,"end":1792584152223}},"id":"prt_15e57748d001Q1sYGcKX4D4Xc3","sessionID":"ses_ea1ad9227ffecapGKKhpmhU0kn","messageID":"msg_15e5756820016hS8ecrwOulsMW"}}
