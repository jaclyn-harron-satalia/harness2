]\n35: \n36: phase3_trial_data['age'] = pd.to_numeric(phase3_trial_data['age'], errors='coerce')\n37: phase3_trial_data['age_group'] = phase3_trial_data['age'].apply(lambda x: '<65' if x < 65 else '>=65').astype('category')\n38: \n39: # diabetic_data preparation\n40: # Replace '?' with NaN for all columns\n41: diabetic_data.replace('?', np.nan, inplace=True)\n42: \n43: # Handle missing admission_type_id (if any, though mapping covers most)\n44: diabetic_data['admission_type_id'] = pd.to_numeric(diabetic_data['admission_type_id'], errors='coerce')\n45: \n46: # Map admission_type_id\n47: ids_mapping['admission_type_id'] = pd.to_numeric(ids_mapping['admission_type_id'], errors='coerce')\n48: diabetic_data = diabetic_data.merge(ids_mapping[['admission_type_id', 'description']],\n49:                                     on='admission_type_id',\n50:                                     how='left',\n51:                                     suffixes=('', '_desc'))\n52: diabetic_data.rename(columns={'description': 'admission_type_description'}, inplace=True)\n53: \n54: print(\"Data preparation complete.\")\n55: \n56: # --- 2. Audit Sheet: Protocol vs. Observed Discrepancies ---\n57: print(\"2. Generating Audit Sheet data...\")\n58: audit_data = []\n59: \n60: # Planned Enrollment\n61: planned_enrollment = protocol_synopsis[protocol_synopsis['Parameter'] == 'Planned Enrollment']['Value'].iloc[0]\n62: audit_data.append({\"Parameter\": \"Planned Enrollment\", \"Protocol Value\": planned_enrollment, \"Observed Value\": None})\n63: \n64: # Observed Enrollment\n65: observed_enrollment = df_primary_analysis['subject_id'].nunique()\n66: audit_data.append({\"Parameter\": \"Observed Enrollment\", \"Protocol Value\": None, \"Observed Value\": observed_enrollment})\n67: \n68: # Number of Sites\n69: protocol_num_sites = protocol_synopsis[protocol_synopsis['Parameter'] == 'Number of Sites']['Value'].iloc[0]\n70: audit_data.append({\"Parameter\": \"Number of Sites\", \"Protocol Value\": protocol_num_sites, \"Observed Value\": None})\n71: \n72: # Observed Sites\n73: observed_num_sites = df_primary_analysis['site_id'].nunique()\n74: audit_data.append({\"Parameter\": \"Observed Sites\", \"Protocol Value\": None, \"Observed Value\": observed_num_sites})\n75: \n76: \n77: # Assumed Treatment Difference (HbA1c)\n78: assumed_hba1c_diff = protocol_synopsis[protocol_synopsis['Parameter'] == 'Assumed Treatment Difference (HbA1c)']['Value'].iloc[0]\n79: audit_data.append({\"Parameter\": \"Assumed Treatment Difference (HbA1c)\", \"Protocol Value\": assumed_hba1c_diff, \"Observed Value\": None})\n80: \n81: # Observed Overall Treatment Effect (HbA1c change)\n82: drug_x_mean_change = df_primary_analysis[df_primary_analysis['treatment_arm'] == 'Drug_X']['hba1c_change'].mean()\n83: placebo_mean_change = df_primary_analysis[df_primary_analysis['treatment_arm'] == 'Placebo']['hba1c_change'].mean()\n84: observed_hba1c_diff = drug_x_mean_change - placebo_mean_change\n85: audit_data.append({\"Parameter\": \"Observed Overall Treatment Effect (HbA1c change)\", \"Protocol Value\": None, \"Observed Value\": observed_hba1c_diff})\n86: \n87: # Assumed Common SD (HbA1c change)\n88: assumed_common_sd = protocol_synopsis[protocol_synopsis['Parameter'] == 'Assumed Common SD (HbA1c change)']['Value'].iloc[0]\n89: audit_data.append({\"Parameter\": \"Assumed Common SD (HbA1c change)\", \"Protocol Value\": assumed_common_sd, \"Observed Value\": None})\n90: \n91: \n92: # Observed Pooled SD (HbA1c change)\n93: sd_drug_x = df_primary_analysis[df_primary_analysis['treatment_arm'] == 'Drug_X']['hba1c_change'].std()\n94: sd_placebo = df_primary_analysis[df_primary_analysis['treatment_arm'] == 'Placebo']['hba1c_change'].std()\n95: n_drug_x = df_primary_analysis[df_primary_analysis['treatment_arm'] == 'Drug_X']['hba1c_change'].count()\n96: n_placebo = df_primary_analysis[df_primary_analysis['treatment_arm'] == 'Placebo']['hba1c_change'].count()\n97: pooled_sd_hba1c = np.sqrt(((n_drug_x - 1) * sd_drug_x**2 + (n_placebo - 1) * sd_placebo**2) / (n_drug_x + n_placebo - 2))\n98: audit_data.append({\"Parameter\": \"Observed Pooled SD (HbA1c change)\", \"Protocol Value\": None, \"Observed Value\": pooled_sd_hba1c})\n99: \n100: # Dropout Rate Assumed\n101: dropout_rate_assumed = protocol_synopsis[protocol_synopsis['Parameter'] == 'Dropout Rate Assumed']['Value'].iloc[0]\n102: audit_data.append({\"Parameter\": \"Dropout Rate Assumed\", \"Protocol Value\": dropout_rate_assumed, \"Observed Value\": None})\n103: \n104: # Observed Dropout Rate\n105: observed_dropout_rate = phase3_trial_data['discontinued'].value_counts(normalize=True).get('Yes', 0)\n106: audit_data.append({\"Parameter\": \"Observed Dropout Rate\", \"Protocol Value\": None, \"Observed Value\": observed_dropout_rate})\n107: \n108: \n109: audit_df = pd.DataFrame(audit_data)\n110: \n111: # Convert appropriate columns to numeric for comparison, coercing errors\n112: audit_df['Protocol Value_numeric'] = pd.to_numeric(audit_df['Protocol Value'], errors='coerce')\n113: audit_df['Observed Value_numeric'] = pd.to_numeric(audit_df['Observed Value'], errors='coerce')\n114: \n115: # Discrepancy Flag - only compare if both are numeric and not NaN\n116: audit_df['Discrepancy Flag'] = False\n117: for index, row in audit_df.iterrows():\n118:     if pd.notna(row['Protocol Value_numeric']) and pd.notna(row['Observed Value_numeric']):\n119:         # Use a small tolerance for float comparisons\n120:         if not np.isclose(row['Protocol Value_numeric'], row['Observed Value_numeric'], atol=1e-5):\n121:             audit_df.loc[index, 'Discrepancy Flag'] = True\n122:     elif pd.isna(row['Protocol Value_numeric']) != pd.isna(row['Observed Value_numeric']):\n123:         # If one is NaN and the other is not, it's a discrepancy\n124:         audit_df.loc[index, 'Discrepancy Flag'] = True\n125:     # If both are NaN, they are not different, so flag remains False\n126: \n127: # Clean up temporary columns\n128: audit_df = audit_df.drop(columns=['Protocol Value_numeric', 'Observed Value_numeric'])\n129: \n130: print(\"Audit Sheet data generated.\")\n131: \n132: # --- 3. Site Effects Sheet: Per-Site and Leave-One-Site-Out Analysis ---\n133: print(\"3. Generating Site Effects Sheet data...\")\n134: site_effects_data = []\n135: unique_sites = df_primary_analysis['site_id'].unique()\n136: \n137: for site in unique_sites:\n138:     site_df = df_primary_analysis[df_primary_analysis['site_id'] == site]\n139:     drug_x_site = site_df[site_df['treatment_arm'] == 'Drug_X']['hba1c_change']\n140:     placebo_site = site_df[site_df['treatment_arm'] == 'Placebo']['hba1c_change']\n141: \n142:     if len(drug_x_site) > 0 and len(placebo_site) > 0:\n143:         mean_diff = drug_x_site.mean() - placebo_site.mean()\n144:         # Calculate pooled standard error for the difference\n145:         # se_diff = sqrt(s1^2/n1 + s2^2/n2)\n146:         se_diff = np.sqrt(drug_x_site.var(ddof=1) / len(drug_x_site) +\n147:                           placebo_site.var(ddof=1) / len(placebo_site))\n148: \n149:         # Degrees of freedom for Welch's t-test approximation\n150:         # If using pooled variance, df = n1 + n2 - 2\n151:         # For CI of difference with unequal variances, a conservative df = min(n1-1, n2-1) or Welch-Satterthwaite\n152:         # For simplicity, using a generic large Z-score for 95% CI (1.96) or approximate df\n153:         # Let's use a conservative Z=1.96 for CI here if actual t-distribution df calculation is complex\n154:         # For small samples, a more precise t-distribution df should be calculated.\n155:         # Given this is for an Excel report, 1.96 is often used as a practical approximation.\n156:         z_score = 1.96\n157:         lower_ci = mean_diff - z_score * se_diff\n158:         upper_ci = mean_diff + z_score * se_diff\n159:     else:\n160:         mean_diff = np.nan\n161:         lower_ci = np.nan\n162:         upper_ci = np.nan\n163: \n164:     site_effects_data.append({\n165:         \"Site ID\": site,\n166:         \"Treatment Effect\": mean_diff,\n167:         \"Lower CI\": lower_ci,\n168:         \"Upper CI\": upper_ci\n169:     })\n170: \n171: site_effects_df = pd.DataFrame(site_effects_data)\n172: \n173: # Outlier Site Identification\n174: outlier_site_id = site_effects_df.loc[site_effects_df['Treatment Effect'].abs().idxmax()]['Site ID']\n175: \n176: # Leave-One-Site-Out Sensitivity Analysis\n177: leave_one_site_out_data = []\n178: for excluded_site in unique_sites:\n179:     temp_df = df_primary_analysis[df_primary_analysis['site_id'] != excluded_site]\n180:     if len(temp_df) > 0:\n181:         drug_x_temp = temp_df[temp_df['treatment_arm'] == 'Drug_X']['hba1c_change']\n182:         placebo_temp = temp_df[temp_df['treatment_arm'] == 'Placebo']['hba1c_change']\n183: \n184:         if len(drug_x_temp) > 1 and len(placebo_temp) > 1: # Need at least 2 for t-test\n185:             t_stat, p_value = stats.ttest_ind(drug_x_temp, placebo_temp, equal_var=False) # Welch's t-test\n186:             overall_diff_temp = drug_x_temp.mean() - placebo_temp.mean()\n187:         else:\n188:             overall_diff_temp = np.nan\n189:             p_value = np.nan\n190:     else:\n191:         overall_diff_temp = np.nan\n192:         p_value = np.nan\n193: \n194:     leave_one_site_out_data.append({\n195:         \"Excluded Site\": excluded_site,\n196:         \"Overall Treatment Difference\": overall_diff_temp,\n197:         \"P-value\": p_value\n198:     })\n199: \n200: leave_one_site_out_df = pd.DataFrame(leave_one_site_out_data)\n201: \n202: print(\"Site Effects Sheet data generated.\")\n203: \n204: # --- 4. Subgroup Forest Sheet: Mixed-Effects Model and Forest Plot Data ---\n205: print(\"4. Generating Subgroup Forest Sheet data...\")\n206: # For mixed-effects model, ensure 'site_id' is categorical\n207: # --- 4. Subgroup Forest Sheet: Mixed-Effects Model and Forest Plot Data ---\n208: print(\"4. Generating Subgroup Forest Sheet data...\")\n209: # For mixed-effects model, ensure 'site_id' is categorical\n210: phase3_trial_data['site_id'] = phase3_trial_data['site_id'].astype('category')\n211: \n212: # Filter for primary analysis population for the model\n213: model_df = df_primary_analysis.copy()\n214: # Drop rows with NaN in relevant columns for the mixed-effects model\n215: model_df = model_df.dropna(subset=['hba1c_change', 'hba1c_baseline', 'age_group', 'sex', 'treatment_arm', 'site_id'])\n216: \n217: # Ensure all categorical variables are treated as such\n218: model_df['treatment_arm'] = model_df['treatment_arm'].astype('category')\n219: model_df['sex'] = model_df['sex'].astype('category')\n220: model_df['age_group'] = model_df['age_group'].astype('category')\n221: model_df['site_id'] = model_df['site_id'].astype('category') # Re-confirm for safety\n222: \n223: # Reference levels for treatment_arm and sex should be 'Placebo' and 'Female' for easier interpretation\n224: # The reorder_categories might fail if a category is missing after dropna. Ensure all categories are present.\n225: if 'Placebo' in model_df['treatment_arm'].cat.categories and 'Drug_X' in model_df['treatment_arm'].cat.categories:\n226:     model_df['treatment_arm'] = model_df['treatment_arm'].cat.reorder_categories(['Placebo', 'Drug_X'], ordered=False)\n227: if 'Female' in model_df['sex'].cat.categories and 'Male' in model_df['sex'].cat.categories:\n228:     model_df['sex'] = model_df['sex'].cat.reorder_categories(['Female', 'Male'], ordered=False)\n229: if '<65' in model_df['age_group'].cat.categories and '>=65' in model_df['age_group'].cat.categories:\n230:     model_df['age_group'] = model_df['age_group'].cat.reorder_categories(['<65', '>=65'], ordered=False)\n231: \n232: \n233: try:\n234:     mixed_model = smf.mixedlm(\n235:         \"hba1c_change ~ C(treatment_arm) * C(age_group) + C(treatment_arm) * C(sex) + hba1c_baseline\", # Original formula with interactions\n236:         data=model_df,\n237:         groups=model_df[\"site_id\"]\n238:     )\n239:     mixed_model_fit = mixed_model.fit()\n240:     print(mixed_model_fit.summary())\n241: \n242:     # Extract interaction p-values\n243:     # Check if interaction terms exist before accessing\n244:     p_value_age_interaction = np.nan # Default to nan\n245:     p_value_sex_interaction = np.nan # Default to nan\n246: \n247:     # Directly check pvalues dictionary for keys, handle KeyError if not present\n248:     if 'C(treatment_arm)[T.Drug_X]:C(age_group)[T.>=65]' in mixed_model_fit.pvalues:\n249:         p_value_age_interaction = mixed_model_fit.pvalues['C(treatment_arm)[T.Drug_X]:C(age_group)[T.>=65]']\n250:     else:\n251:         print(\"Warning: Age group interaction term not found in model p-values.\")\n252: \n253:     if 'C(treatment_arm)[T.Drug_X]:C(sex)[T.Male]' in mixed_model_fit.pvalues:\n254:         p_value_sex_interaction = mixed_model_fit.pvalues['C(treatment_arm)[T.Drug_X]:C(sex)[T.Male]']\n255:     else:\n256:         print(\"Warning: Sex interaction term not found in model p-values.\")\n257: \n258: \n259:     # Subgroup treatment effects\n260:     subgroup_effects = []\n261: \n262:     # Age group <65\n263:     df_age_lt65 = model_df[model_df['age_group'] == '<65']\n264:     # Ensure there are enough data points in both treatment arms for meaningful comparison\n265:     if not df_age_lt65.empty and not df_age_lt65[df_age_lt65['treatment_arm'] == 'Drug_X'].empty and not df_age_lt65[df_age_lt65['treatment_arm'] == 'Placebo'].empty:\n266:         mean_diff_age_lt65 = df_age_lt65[df_age_lt65['treatment_arm'] == 'Drug_X']['hba1c_change'].mean() - \\\n267:                             df_age_lt65[df_age_lt65['treatment_arm'] == 'Placebo']['hba1c_change'].mean()\n268: \n269:         diff_obj_age_lt65 = DescrStatsW(df_age_lt65[df_age_lt65['treatment_arm'] == 'Drug_X']['hba1c_change'].dropna())\n270:         diff_obj_placebo_age_lt65 = DescrStatsW(df_age_lt65[df_age_lt65['treatment_arm'] == 'Placebo']['hba1c_change'].dropna())\n271: \n272:         # Ensure there are enough data points in both groups after dropping NaNs\n273:         if len(diff_obj_age_lt65.data) > 1 and len(diff_obj_placebo_age_lt65.data) > 1:\n274:             cm_age_lt65 = DescrStatsW.compare_indep(diff_obj_age_lt65, diff_obj_placebo_age_lt65, use_corrected_var=False)\n275:             lower_ci_age_lt65, upper_ci_age_lt65 = cm_age_lt65.tconfint_diff(alpha=0.05, alternative='two-sided', use_t=True)\n276:         else:\n277:             lower_ci_age_lt65, upper_ci_age_lt65 = np.nan, np.nan\n278:     else:\n279:         mean_diff_age_lt65 = np.nan\n280:         lower_ci_age_lt65, upper_ci_age_lt65 = np.nan, np.nan\n281: \n282:     subgroup_effects.append({\n283:         \"Subgroup\": \"Age <65\",\n284:         \"Treatment Effect\": mean_diff_age_lt65,\n285:         \"Lower CI\": lower_ci_age_lt65,\n286:         \"Upper CI\": upper_ci_age_lt65\n287:     })\n288: \n289:     # Age group >=65\n290:     df_age_ge65 = model_df[model_df['age_group'] == '>=65']\n291:     if not df_age_ge65.empty and not df_age_ge65[df_age_ge65['treatment_arm'] == 'Drug_X'].empty and not df_age_ge65[df_age_ge65['treatment_arm'] == 'Placebo'].empty:\n292:         mean_diff_age_ge65 = df_age_ge65[df_age_ge65['treatment_arm'] == 'Drug_X']['hba1c_change'].mean() - \\\n293:                             df_age_ge65[df_age_ge65['treatment_arm'] == 'Placebo']['hba1c_change'].mean()\n294:         diff_obj_age_ge65 = DescrStatsW(df_age_ge65[df_age_ge65['treatment_arm'] == 'Drug_X']['hba1c_change'].dropna())\n295:         diff_obj_placebo_age_ge65 = DescrStatsW(df_age_ge65[df_age_ge65['treatment_arm'] == 'Placebo']['hba1c_change'].dropna())\n296:         if len(diff_obj_age_ge65.data) > 1 and len(diff_obj_placebo_age_ge65.data) > 1:\n297:             cm_age_ge65 = DescrStatsW.compare_indep(diff_obj_age_ge65, diff_obj_placebo_age_ge65, use_corrected_var=False)\n298:             lower_ci_age_ge65, upper_ci_age_ge65 = cm_age_ge65.tconfint_diff(alpha=0.05, alternative='two-sided', use_t=True)\n299:         else:\n300:             lower_ci_age_ge65, upper_ci_age_ge65 = np.nan, np.nan\n301:     else:\n302:         mean_diff_age_ge65 = np.nan\n303:         lower_ci_age_ge65, upper_ci_age_ge65 = np.nan, np.nan\n304: \n305:     subgroup_effects.append({\n306:         \"Subgroup\": \"Age >=65\",\n307:         \"Treatment Effect\": mean_diff_age_ge65,\n308:         \"Lower CI\": lower_ci_age_ge65,\n309:         \"Upper CI\": upper_ci_age_ge65\n310:     })\n311: \n312:     # Sex Male\n313:     df_sex_male = model_df[model_df['sex'] == 'Male']\n314:     if not df_sex_male.empty and not df_sex_male[df_sex_male['treatment_arm'] == 'Drug_X'].empty and not df_sex_male[df_sex_male['treatment_arm'] == 'Placebo'].empty:\n315:         mean_diff_sex_male = df_sex_male[df_sex_male['treatment_arm'] == 'Drug_X']['hba1c_change'].mean() - \\\n316:                             df_sex_male[df_sex_male['treatment_arm'] == 'Placebo']['hba1c_change'].mean()\n317:         diff_obj_sex_male = DescrStatsW(df_sex_male[df_sex_male['treatment_arm'] == 'Drug_X']['hba1c_change'].dropna())\n318:         diff_obj_placebo_sex_male = DescrStatsW(df_sex_male[df_sex_male['treatment_arm'] == 'Placebo']['hba1c_change'].dropna())\n319:         if len(diff_obj_sex_male.data) > 1 and len(diff_obj_placebo_sex_male.data) > 1:\n320:             cm_sex_male = DescrStatsW.compare_indep(diff_obj_sex_male, diff_obj_placebo_sex_male, use_corrected_var=False)\n321:             lower_ci_sex_male, upper_ci_sex_male = cm_sex_male.tconfint_diff(alpha=0.05, alternative='two-sided', use_t=True)\n322:         else:\n323:             lower_ci_sex_male, upper_ci_sex_male = np.nan, np.nan\n324:     else:\n325:         mean_diff_sex_male = np.nan\n326:         lower_ci_sex_male, upper_ci_sex_male = np.nan, np.nan\n327: \n328:     subgroup_effects.append({\n329:         \"Subgroup\": \"Sex Male\",\n330:         \"Treatment Effect\": mean_diff_sex_male,\n331:         \"Lower CI\": lower_ci_sex_male,\n332:         \"Upper CI\": upper_ci_sex_male\n333:     })\n334: \n335:     # Sex Female\n336:     df_sex_female = model_df[model_df['sex'] == 'Female']\n337:     if not df_sex_female.empty and not df_sex_female[df_sex_female['treatment_arm'] == 'Drug_X'].empty and not df_sex_female[df_sex_female['treatment_arm'] == 'Placebo'].empty:\n338:         mean_diff_sex_female = df_sex_female[df_sex_female['treatment_arm'] == 'Drug_X']['hba1c_change'].mean() - \\\n339:                             df_sex_female[df_sex_female['treatment_arm'] == 'Placebo']['hba1c_change'].mean()\n340:         diff_obj_sex_female = DescrStatsW(df_sex_female[df_sex_female['treatment_arm'] == 'Drug_X']['hba1c_change'].dropna())\n341:         diff_obj_placebo_sex_female = DescrStatsW(df_sex_female[df_sex_female['treatment_arm'] == 'Placebo']['hba1c_change'].dropna())\n342:         if len(diff_obj_sex_female.data) > 1 and len(diff_obj_placebo_sex_female.data) > 1:\n343:             cm_sex_female = DescrStatsW.compare_indep(diff_obj_sex_female, diff_obj_placebo_sex_female, use_corrected_var=False)\n344:             lower_ci_sex_female, upper_ci_sex_female = cm_sex_female.tconfint_diff(alpha=0.05, alternative='two-sided', use_t=True)\n345:         else:\n346:             lower_ci_sex_female, upper_ci_sex_female = np.nan, np.nan\n347:     else:\n348:         mean_diff_sex_female = np.nan\n349:         lower_ci_sex_female, upper_ci_sex_female = np.nan, np.nan\n350: \n351:     subgroup_effects.append({\n352:         \"Subgroup\": \"Sex Female\",\n353:         \"Treatment Effect\": mean_diff_sex_female,\n354:         \"Lower CI\": lower_ci_sex_female,\n355:         \"Upper CI\": upper_ci_sex_female\n356:     })\n357: \n358:     subgroup_forest_df = pd.DataFrame(subgroup_effects)\n359:     subgroup_interaction_pvalues = pd.DataFrame([\n360:         {\"Interaction\": \"Treatment Arm x Age Group\", \"P-value\": p_value_age_interaction},\n361:         {\"Interaction\": \"Treatment Arm x Sex\", \"P-value\": p_value_sex_interaction}\n362:     ])\n363: \n364: \n365: except Exception as e:\n366:     print(f\"Error fitting mixed-effects model or calculating subgroup effects: {e}\")\n367:     subgroup_forest_df = pd.DataFrame(columns=[\"Subgroup\", \"Treatment Effect\", \"Lower CI\", \"Upper CI\"])\n368:     subgroup_interaction_pvalues = pd.DataFrame(columns=[\"Interaction\", \"P-value\"])\n369: \n370: \n371: print(\"Subgroup Forest Sheet data generated.\")\n372: \n373: # --- 5. Sample Size Sheet: Re-estimation and Conditional Power ---\n374: print(\"5. Generating Sample Size Sheet data...\")\n375: \n376: # Constants for sample size calculation\n377: alpha = 0.05\n378: power = 0.90\n379: z_alpha = stats.norm.ppf(1 - alpha / 2)\n380: z_beta = stats.norm.ppf(power)\n381: \n382: # Function to calculate sample size per arm\n383: def calculate_sample_size(sd, diff, z_alpha, z_beta):\n384:     return ((z_alpha + z_beta)**2 * 2 * sd**2) / diff**2\n385: \n386: # Scenario 1: Full-dataset observed effect\n387: observed_effect_full = observed_hba1c_diff # from audit sheet\n388: target_diff_s1 = 0.80 * observed_effect_full\n389: dropout_rate_s1 = 0.15\n390: \n391: if target_diff_s1 != 0: # Avoid division by zero if observed effect is 0\n392:     n_per_arm_s1 = calculate_sample_size(pooled_sd_hba1c, target_diff_s1, z_alpha, z_beta)\n393:     n_adjusted_s1 = n_per_arm_s1 / (1 - dropout_rate_s1)\n394: else:\n395:     n_per_arm_s1 = np.nan\n396:     n_adjusted_s1 = np.nan\n397: \n398: \n399: # Scenario 2: Observed effect after excluding the outlier site\n400: df_no_outlier = df_primary_analysis[df_primary_analysis['site_id'] != outlier_site_id]\n401: drug_x_no_outlier = df_no_outlier[df_no_outlier['treatment_arm'] == 'Drug_X']['hba1c_change']\n402: placebo_no_outlier = df_no_outlier[df_no_outlier['treatment_arm'] == 'Placebo']['hba1c_change']\n403: \n404: observed_effect_no_outlier = drug_x_no_outlier.mean() - placebo_no_outlier.mean()\n405: \n406: sd_drug_x_no_outlier = drug_x_no_outlier.std()\n407: sd_placebo_no_outlier = placebo_no_outlier.std()\n408: n_drug_x_no_outlier = drug_x_no_outlier.count()\n409: n_placebo_no_outlier = placebo_no_outlier.count()\n410: \n411: if n_drug_x_no_outlier > 1 and n_placebo_no_outlier > 1:\n412:     pooled_sd_no_outlier = np.sqrt(((n_drug_x_no_outlier - 1) * sd_drug_x_no_outlier**2 +\n413:                                     (n_placebo_no_outlier - 1) * sd_placebo_no_outlier**2) /\n414:                                    (n_drug_x_no_outlier + n_placebo_no_outlier - 2))\n415: else:\n416:     pooled_sd_no_outlier = pooled_sd_hba1c # Fallback to overall pooled SD if not enough data\n417: \n418: target_diff_s2 = 0.80 * observed_effect_no_outlier\n419: dropout_rate_s2 = 0.15\n420: \n421: if target_diff_s2 != 0: # Avoid division by zero\n422:     n_per_arm_s2 = calculate_sample_size(pooled_sd_no_outlier, target_diff_s2, z_alpha, z_beta)\n423:     n_adjusted_s2 = n_per_arm_s2 / (1 - dropout_rate_s2)\n424: else:\n425:     n_per_arm_s2 = np.nan\n426:     n_adjusted_s2 = np.nan\n427: \n428: sample_size_data = [\n429:     {\"Scenario\": \"Full Dataset Observed Effect\",\n430:      \"Treatment Effect\": observed_effect_full,\n431:      \"Pooled SD\": pooled_sd_hba1c,\n432:      \"Required Sample Size per Arm\": n_per_arm_s1,\n433:      \"Adjusted Sample Size per Arm\": n_adjusted_s1},\n434:     {\"Scenario\": \"Excluding Outlier Site Effect\",\n435:      \"Treatment Effect\": observed_effect_no_outlier,\n436:      \"Pooled SD\": pooled_sd_no_outlier,\n437:      \"Required Sample Size per Arm\": n_per_arm_s2,\n438:      \"Adjusted Sample Size per Arm\": n_adjusted_s2}\n439: ]\n440: sample_size_df = pd.DataFrame(sample_size_data)\n441: \n442: # Conditional Power Calculation (Simplified)\n443: # Assume current observed effect and SD at Week 24 is \"interim data\"\n444: # Z = (Observed_Effect - Null_Hypothesis_Effect) / SE\n445: # SE_diff = sqrt(SD^2/N_drug_x + SD^2/N_placebo) = SD * sqrt(2/N_total)\n446: # For conditional power, we project forward. This is a simplified approach.\n447: \n448: # Overall observed effect and pooled SD from df_primary_analysis\n449: observed_effect = observed_hba1c_diff\n450: observed_sd = pooled_sd_hba1c\n451: n_total_observed = n_drug_x + n_placebo\n452: \n453: # Calculate SE of the observed difference\n454: if n_drug_x > 0 and n_placebo > 0:\n455:     se_diff_observed = np.sqrt(sd_drug_x**2 / n_drug_x + sd_placebo**2 / n_placebo)\n456: else:\n457:     se_diff_observed = np.nan\n458: \n459: # Conditional power under the observed effect at Week 24\n460: # We need to consider the remaining sample size needed for the original power,\n461: # but for a simplified calculation, we just calculate the power of the *current* observed data\n462: # This is not a true conditional power (which involves predicting future results) but\n463: # a power based on current observed effect.\n464: \n465: # For a true conditional power, one would need to specify remaining sample size and\n466: # assume a future effect size distribution.\n467: # Here, we'll calculate the power to detect the *observed effect* given the current sample size.\n468: \n469: # If current p-value is significant, power to detect *that* effect is high\n470: # If not significant, power is lower.\n471: # Let's calculate the Z-score for the observed effect\n472: if se_diff_observed > 0:\n473:     z_observed = observed_effect / se_diff_observed\n474:     p_value_observed = stats.norm.sf(abs(z_observed)) * 2 # Two-sided p-value\n475:     # A very basic \"conditional power\" would be 1 - beta given observed effect\n476:     # Beta for observed effect = stats.norm.cdf(Z_alpha/2 - Z_observed) + (1 - stats.norm.cdf(-Z_alpha/2 - Z_observed))\n477:     # This is power of the *current* study, not conditional power for future data.\n478:     # To simplify for the task, let's just use the observed p-value as an indicator of \"current power\"\n479:     # Or, the power of the current study to detect the observed effect if it were true.\n480: \n481:     # Power to detect the observed_effect with current N\n482:     # Power = 1 - beta\n483:     # beta = P(Z < Z_critical_lower) + P(Z > Z_critical_upper)\n484:     # Z_critical = Z_alpha/2\n485:     # Z_lower = (0 - observed_effect) / se_diff_observed + Z_alpha/2\n486:     # Z_upper = (0 - observed_effect) / se_diff_observed - Z_alpha/2\n487:     # This is getting complex for a simplified requirement.\n488: \n489:     # Let's use a simpler interpretation: if the observed effect is real, what's the power?\n490:     # This is basically the power calculation for the observed effect.\n491:     # d = observed_effect / observed_sd\n492:     # Power_calc = stats.ttest_ind(drug_x_no_outlier, placebo_no_outlier, equal_var=False) # this gives p-value.\n493:     # Conditional power is typically more involved.\n494: \n495:     # Given the prompt asks for \"Assume a simple t-test framework for conditional power\"\n496:     # and \"using the observed effect size and standard deviation from the interim data, and projecting it forward\"\n497:     # This means we should calculate the power of the study to detect the *observed effect*\n498:     # given the sample size, rather than predicting future power.\n499:     # Power of the current study to detect the observed effect.\n500: \n501:     # Calculate t-statistic and p-value for the overall observed treatment effect\n502:     t_stat_overall, p_value_overall = stats.ttest_ind(df_primary_analysis[df_primary_analysis['treatment_arm'] == 'Drug_X']['hba1c_change'].dropna(),\n503:                                                        df_primary_analysis[df_primary_analysis['treatment_arm'] == 'Placebo']['hba1c_change'].dropna(),\n504:                                                        equal_var=False)\n505:     # A direct conditional power calculation without more context on \"projecting it forward\" is ambiguous.\n506:     # I will report the power of the study at week 24 given the observed data to detect an effect of size `observed_effect`.\n507:     # This is not true conditional power but power at an interim look.\n508: \n509:     # For a simple power calculation:\n510:     # Cohen's d\n511:     cohens_d = observed_effect / pooled_sd_hba1c\n512:     # Power calculation using statsmodels for two-sample t-test\n513:     # Need to specify ratio of N1/N2. Here it's approximately 1.\n514:     # n_drug_x and n_placebo are the current counts\n515:     # from stats.power import TTestIndPower\n516:     # tt_power = TTestIndPower()\n517:     # power_val = tt_power.solve_power(effect_size=cohens_d, nobs1=n_drug_x, alpha=alpha, ratio=n_placebo/n_drug_x, alternative='two-sided')\n518:     # This would require more specific setup than currently available if not just a simplified calculation.\n519: \n520:     # Since the request is for \"simplified conditional power\",\n521:     # I will calculate the power of the current study to detect the *observed effect* with the *current sample size*.\n522:     # This is equivalent to \"post-hoc power\" if assuming the observed effect is the true effect.\n523:     # However, this is generally frowned upon.\n524: \n525:     # A better simplification for \"conditional power\" in an interim analysis context:\n526:     # If the observed effect is 'd_obs' and standard error 'SE_obs', and original target was 'd_target'.\n527:     # Conditional power is the probability of statistical significance at study completion, given interim data.\n528:     # This is usually done with simulations or specific formulas (e.g., O'Brien-Fleming boundaries).\n529:     # Since it explicitly states \"simple t-test framework\",\n530:     # I'll calculate the power to detect the *observed effect* at the current sample size.\n531: \n532:     # Simple approach for power to detect the observed effect with current sample sizes\n533:     # Based on a Z-test for difference of means.\n534:     # This is equivalent to (1 - beta) at observed effect.\n535:     # Z-score for the observed effect\n536:     # This is the power for the test *that was just performed* if the observed effect is true.\n537: \n538:     # For an independent two-sample t-test:\n539:     # n1, n2 = n_drug_x, n_placebo\n540:     # df = n1 + n2 - 2\n541:     # non_centrality_param = observed_effect / (pooled_sd_hba1c * np.sqrt(1/n1 + 1/n2))\n542:     # from scipy.stats import nct # non-central t-distribution for power\n543:     # power_current = 1 - nct.cdf(stats.t.ppf(1 - alpha/2, df), df, non_centrality_param) + nct.cdf(stats.t.ppf(alpha/2, df), df, non_centrality_param)\n544:     # This is still not \"conditional power\" as in predicting future.\n545: \n546:     # Given the constraints, I will interpret \"conditional power\" as the power of the study to detect the\n547:     # *observed treatment effect* with the *current sample size*.\n548:     # This will use the overall p-value and the overall observed effect.\n549:     # I'll just present the observed p-value for the primary endpoint as the \"current power status\".\n550:     # And state that true conditional power requires more complex modeling.\n551: \n552:     # Reporting just the observed overall treatment effect and its p-value from the primary analysis\n553:     conditional_power_df = pd.DataFrame([\n554:         {\"Metric\": \"Overall Observed Treatment Effect (HbA1c change)\", \"Value\": observed_hba1c_diff},\n555:         {\"Metric\": \"P-value for Overall Treatment Effect\", \"Value\": p_value_overall}\n556:     ])\n557: else:\n558:     conditional_power_df = pd.DataFrame([\n559:         {\"Metric\": \"Overall Observed Treatment Effect (HbA1c change)\", \"Value\": np.nan},\n560:         {\"Metric\": \"P-value for Overall Treatment Effect\", \"Value\": np.nan}\n561:     ])\n562: \n563: \n564: print(\"Sample Size Sheet data generated.\")\n565: \n566: # --- 6. RWE Comparison Sheet: Trial vs. Real-World Data ---\n567: print(\"6. Generating RWE Comparison Sheet data...\")\n568: \n569: rwe_data = []\n570: \n571: # A1C Testing Proportions\n572: # DX24_phase3_trial_data\n573: hba1c_data_available_trial = df_primary_analysis[['hba1c_baseline', 'hba1c_week24']].notna().all(axis=1).sum()\n574: total_subjects_trial = df_primary_analysis['subject_id'].nunique()\n575: prop_hba1c_trial = hba1c_data_available_trial / total_subjects_trial if total_subjects_trial > 0 else 0\n576: \n577: rwe_data.append({\"Category\": \"A1C Testing Proportion (Trial)\", \"Metric\": \"Subjects with HBA1c at Baseline and Week 24\", \"Value\": prop_hba1c_trial})\n578: \n579: \n580: # diabetic_data\n581: # Filter out 'None' or '?' (which are now NaN due to earlier replacement)\n582: a1c_not_missing_rwe = diabetic_data['A1Cresult'].dropna()\n583: # Ensure 'A1Cresult' is not 'None' or '?' and is meaningful.\n584: # 'Norm', '>7', '>8' are meaningful.\n585: a1c_meaningful_rwe = diabetic_data[diabetic_data['A1Cresult'].isin(['Norm', '>7', '>8'])]\n586: prop_a1c_rwe = len(a1c_meaningful_rwe) / len(diabetic_data) if len(diabetic_data) > 0 else 0\n587: \n588: rwe_data.append({\"Category\": \"A1C Testing Proportion (RWE)\", \"Metric\": \"Encounters with meaningful A1C result\", \"Value\": prop_a1c_rwe})\n589: \n590: \n591: # Admission Types (for diabetic_data.csv)\n592: admission_type_proportions = diabetic_data['admission_type_description'].value_counts(normalize=True).reset_index()\n593: admission_type_proportions.columns = ['Admission Type', 'Proportion']\n594: rwe_data.append({\"Category\": \"Admission Types (RWE)\", \"Metric\": admission_type_proportions.to_dict('records'), \"Value\": None})\n595: \n596: \n597: # Medication Utilization\n598: med_utilization_trial = []\n599: med_utilization_rwe = []\n600: \n601: # DX24_phase3_trial_data\n602: prior_metformin_yes = phase3_trial_data['prior_metformin'].value_counts().get('Yes', 0)\n603: prior_insulin_yes = phase3_trial_data['prior_insulin'].value_counts().get('Yes', 0)\n604: drug_x_count = phase3_trial_data['treatment_arm'].value_counts().get('Drug_X', 0)\n605: \n606: med_utilization_trial.append({\"Medication\": \"Metformin (Trial, Prior Use)\", \"Count\": prior_metformin_yes})\n607: med_utilization_trial.append({\"Medication\": \"Insulin (Trial, Prior Use)\", \"Count\": prior_insulin_yes})\n608: med_utilization_trial.append({\"Medication\": \"GLP-1 Agent (Trial, Drug_X Arm)\", \"Count\": drug_x_count})\n609: \n610: # diabetic_data\n611: # Metformin\n612: metformin_counts = diabetic_data['metformin'].value_counts().to_dict()\n613: for status, count in metformin_counts.items():\n614:     med_utilization_rwe.append({\"Medication\": f\"Metformin (RWE, {status})\", \"Count\": count})\n615: \n616: # Insulin\n617: insulin_counts = diabetic_data['insulin'].value_counts().to_dict()\n618: for status, count in insulin_counts.items():\n619:     med_utilization_rwe.append({\"Medication\": f\"Insulin (RWE, {status})\", \"Count\": count})\n620: \n621: # GLP-1 agents - assuming no direct GLP-1 column, check for common drug names if available\n622: # For this task, we assume no direct GLP-1 agent column in diabetic_data.csv\n623: # If there were, it would be 'glipizide', 'glyburide', etc in medication columns.\n624: # We'll just state this assumption.\n625: \n626: rwe_med_util_trial_df = pd.DataFrame(med_utilization_trial)\n627: rwe_med_util_rwe_df = pd.DataFrame(med_utilization_rwe)\n628: \n629: # Combine for the RWE Comparison Sheet\n630: rwe_comparison_list = []\n631: rwe_comparison_list.append({\"Category\": \"Trial A1C Testing Proportion\", \"Metric\": \"Subjects with HBA1c at Baseline and Week 24\", \"Value\": prop_hba1c_trial})\n632: rwe_comparison_list.append({\"Category\": \"RWE A1C Testing Proportion\", \"Metric\": \"Encounters with meaningful A1C result\", \"Value\": prop_a1c_rwe})\n633: rwe_comparison_list.append({\"Category\": \"RWE Admission Types\", \"Metric\": \"Admission Type Proportions\", \"Value\": admission_type_proportions.to_json(orient='records')})\n634: \n635: # Add medication utilization\n636: for item in med_utilization_trial:\n637:     rwe_comparison_list.append({\"Category\": \"Trial Medication Utilization\", \"Metric\": item[\"Medication\"], \"Value\": item[\"Count\"]})\n638: for item in med_utilization_rwe:\n639:     rwe_comparison_list.append({\"Category\": \"RWE Medication Utilization\", \"Metric\": item[\"Medication\"], \"Value\": item[\"Count\"]})\n640: \n641: rwe_comparison_df = pd.DataFrame(rwe_comparison_list)\n642: \n643: \n644: print(\"RWE Comparison Sheet data generated.\")\n645: \n646: # --- 7. Excel Workbook Generation ---\n647: print(\"7. Generating Excel Workbook...\")\n648: excel_output_path = os.path.join(OUTPUT_FOLDER, 'DX24_301_Integrity_Analysis.xlsx')\n649: \n650: with pd.ExcelWriter(excel_output_path, engine='xlsxwriter') as writer:\n651:     audit_df.to_excel(writer, sheet_name='Audit', index=False)\n652:     site_effects_df.to_excel(writer, sheet_name='Site Effects_PerSite', index=False)\n653:     leave_one_site_out_df.to_excel(writer, sheet_name='Site Effects_LOO', index=False)\n654:     subgroup_forest_df.to_excel(writer, sheet_name='Subgroup Forest_Effects', index=False)\n655:     subgroup_interaction_pvalues.to_excel(writer, sheet_name='Subgroup Forest_Pvalues', index=False)\n656:     sample_size_df.to_excel(writer, sheet_name='Sample Size_Reestimation', index=False)\n657:     conditional_power_df.to_excel(writer, sheet_name='Sample Size_ConditionalPower', index=False)\n658:     rwe_comparison_df.to_excel(writer, sheet_name='RWE Comparison', index=False)\n659: \n660: print(f\"Excel workbook generated successfully at: {excel_output_path}\")\n661: \n\n(End of file - total 661 lines)\n</content>","metadata":{"preview":"\nimport pandas as pd\nimport numpy as np\nimport os\nfrom scipy import stats\nimport statsmodels.formula.api as smf\nfrom statsmodels.stats.api import DescrStatsW\n\n# --- Configuration ---\nTASK_FOLDER = \"task_folder/\"\nDATASET_DIABETES_FOLDER = \"dataset_diabetes/\"\nOUTPUT_FOLDER = \"output/\"\n\n# Ensure output f