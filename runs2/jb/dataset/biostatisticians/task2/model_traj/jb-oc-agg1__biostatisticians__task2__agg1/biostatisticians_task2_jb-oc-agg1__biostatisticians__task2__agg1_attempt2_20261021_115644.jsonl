wer_ci_age_lt65, upper_ci_age_lt65 = np.nan, np.nan\n    else:\n        mean_diff_age_lt65 = np.nan\n        lower_ci_age_lt65, upper_ci_age_lt65 = np.nan, np.nan\n\n    subgroup_effects.append({\n        \"Subgroup\": \"Age <65\",\n        \"Treatment Effect\": mean_diff_age_lt65,\n        \"Lower CI\": lower_ci_age_lt65,\n        \"Upper CI\": upper_ci_age_lt65\n    })\n\n    # Age group >=65\n    df_age_ge65 = model_df[model_df['age_group'] == '>=65']\n    if not df_age_ge65.empty and not df_age_ge65[df_age_ge65['treatment_arm'] == 'Drug_X'].empty and not df_age_ge65[df_age_ge65['treatment_arm'] == 'Placebo'].empty:\n        mean_diff_age_ge65 = df_age_ge65[df_age_ge65['treatment_arm'] == 'Drug_X']['hba1c_change'].mean() - \\\n                            df_age_ge65[df_age_ge65['treatment_arm'] == 'Placebo']['hba1c_change'].mean()\n        diff_obj_age_ge65 = DescrStatsW(df_age_ge65[df_age_ge65['treatment_arm'] == 'Drug_X']['hba1c_change'].dropna())\n        diff_obj_placebo_age_ge65 = DescrStatsW(df_age_ge65[df_age_ge65['treatment_arm'] == 'Placebo']['hba1c_change'].dropna())\n        if len(diff_obj_age_ge65.data) > 1 and len(diff_obj_placebo_age_ge65.data) > 1:\n            cm_age_ge65 = DescrStatsW.compare_indep(diff_obj_age_ge65, diff_obj_placebo_age_ge65, use_corrected_var=False)\n            lower_ci_age_ge65, upper_ci_age_ge65 = cm_age_ge65.tconfint_diff(alpha=0.05, alternative='two-sided', use_t=True)\n        else:\n            lower_ci_age_ge65, upper_ci_age_ge65 = np.nan, np.nan\n    else:\n        mean_diff_age_ge65 = np.nan\n        lower_ci_age_ge65, upper_ci_age_ge65 = np.nan, np.nan\n\n    subgroup_effects.append({\n        \"Subgroup\": \"Age >=65\",\n        \"Treatment Effect\": mean_diff_age_ge65,\n        \"Lower CI\": lower_ci_age_ge65,\n        \"Upper CI\": upper_ci_age_ge65\n    })\n\n    # Sex Male\n    df_sex_male = model_df[model_df['sex'] == 'Male']\n    if not df_sex_male.empty and not df_sex_male[df_sex_male['treatment_arm'] == 'Dr